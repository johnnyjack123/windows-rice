{
  "name": "rice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Windows desktop rice: dynamic island, control centre and more (Tauri 2 + Svelte 5)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "icons": "node scripts/fetch-icons.mjs",
    "tauri": "tauri",
    "release": "tauri build --config src-tauri/tauri.release.conf.json",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@tauri-apps/api": "2.12.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "^24.19.2",
    "jsdom": "30.1.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
